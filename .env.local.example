# Circle API credentials (https://console.circle.com)
CIRCLE_API_KEY=
CIRCLE…RET=

# Facilitator wallet (create via arc_create_wallet, then add ID here)
CIRCLE_FACILITATOR_WALLET_ID=

# Google AI (for Vercel AI SDK with Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=

*** Google AI (for @google/genai SDK)
GEMINI_API_KEY=

*** Facilitator bind address (default 127.0.0.1)
# FACILITATOR_HOST=127.0.0.1

# Optional: Postgres for payment history. Unset = history is kept in memory
# and lost on restart. Example: postgresql://user:password@host:5432/dbname
# DATABASE_URL=

# Optional: enables the admin endpoints (POST /api/stats/reset, POST /api/stats).
# Unset = those endpoints return 404. Use a long random value.
# ADMIN_TOKEN=

# In-page buyer agent (spends from this server's own Circle wallets).
# Set to false on any public deployment.
# ENABLE_BUYER_AGENT=true
